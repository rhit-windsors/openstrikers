+// Set NL_TRACE_ALLOC_SIZE (decimal or 0x-prefixed) to have every allocation of
+// exactly that user size print a backtrace. The op log says *where* a block is
+// and what happened to it; this says *who asked for it*, which is what you need
+// once the log has narrowed the damage to one buffer.
+extern "C" void osDumpBacktrace(const char* tag, unsigned skip);
+
+u32 nlTraceAllocSize()
+{
+    static bool read = false;
+    static u32 value = 0;
+    if (!read)
+    {
+        read = true;
+        const char* env = getenv("NL_TRACE_ALLOC_SIZE");
+        if (env != NULL)
+        {
+            value = (u32)strtoul(env, NULL, 0);
+        }
+    }
+    return value;
+}
