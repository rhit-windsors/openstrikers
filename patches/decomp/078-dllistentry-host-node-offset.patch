--- a/include/NL/nlDLRing.h
+++ b/include/NL/nlDLRing.h
@@ -7,6 +7,22 @@
 #include "NL/nlRing.h"
 
 template <typename T>
+class DLListEntry;
+
+// Recover the node from a pointer to the value inside it. The decomp spells
+// this as `(Entry*)((char*)value - 8)`, 8 being the two 32-bit link pointers a
+// GameCube node started with; ours are 8 bytes each, so the hand-written
+// constant lands in the middle of the node and the next unlink writes through
+// whatever it finds there. Ask the type instead.
+template <typename T>
+inline DLListEntry<T>* nlDLEntryFromValue(T* value)
+{
+    const char* zero = (const char*)0;
+    const size_t offset = (const char*)&((DLListEntry<T>*)0)->entry - zero;
+    return (DLListEntry<T>*)((char*)value - offset);
+}
+
+template <typename T>
 class DLListEntry
 {
 public:
