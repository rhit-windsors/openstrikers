+#ifndef _NLGCPTR_H_
+#define _NLGCPTR_H_
+
+#include "types.h"
+
+#include <stdint.h>
+
+// A pointer the width the GameCube had: four bytes.
+//
+// Serialized images (.fen scene packages and friends) bake the pointer size into
+// their layout and are fixed up in place by a relocation table, so any field the
+// relocation pass touches has to stay four bytes wide on a 64-bit host or every
+// offset after it slides. MEM1 is mapped at its real 0x8xxxxxxx address, so every
+// pointer that can appear in one of these images fits losslessly.
+//
+// Relocation writes these in native byte order -- it is the point where the image
+// stops being file data -- so unlike the scalars beside them this is not a nlBE.
+// Anything a serialized struct points at must live in MEM1: a pointer to a static
+// object in the executable image does not fit in 32 bits and will truncate.
+template <typename T>
+struct nlGCPtr32
+{
+    u32 m_addr;
+
+    operator T*() const { return reinterpret_cast<T*>(static_cast<uintptr_t>(m_addr)); }
+    T* operator->() const { return operator T*(); }
+    T& operator*() const { return *operator T*(); }
+    T& operator[](int i) const { return operator T*()[i]; }
+    nlGCPtr32& operator=(T* p)
+    {
+        m_addr = static_cast<u32>(reinterpret_cast<uintptr_t>(p));
+        return *this;
+    }
+};
+
+// The decomp records the GameCube offset of every field and the size of every
+// struct in comments. For anything that is read straight out of a file those
+// comments are a contract, not documentation, so state them to the compiler.
+#define NL_GC_LAYOUT(type, size) static_assert(sizeof(type) == (size), #type " is not its GameCube size")
+#define NL_GC_FIELD(type, field, offset) \
+    static_assert(__builtin_offsetof(type, field) == (offset), #type "::" #field " moved")
+
+#endif // _NLGCPTR_H_
