+// nlTextBox::StringDrawInfo::String is an nlGCPtr32 -- four bytes, because
+// StringDrawInfo is embedded in a serialized .fen image. Whatever FontCharString
+// builds therefore has to live in MEM1. On hardware __alloca gave that for free,
+// since the stack was in MEM1 too; here it returns a host stack address that
+// loses its top 32 bits going into the slot, and ProcessString then walks
+// whatever the low half happens to name.
+//
+// One grown-on-demand buffer is enough, and it is strictly safer than the alloca
+// it replaces: that buffer died when Render() returned even though
+// m_DrawInfo.String went on pointing at it.
+static unsigned short* GetTextScratch(unsigned long chars)
+{
+    static unsigned short* pBuffer = NULL;
+    static unsigned long capacity = 0;
+
+    if (chars > capacity)
+    {
+        if (pBuffer != NULL)
+        {
+            nlFree(pBuffer);
+        }
+        pBuffer = (unsigned short*)nlMalloc(chars * sizeof(unsigned short), 8, false);
+        capacity = chars;
+    }
+    return pBuffer;
+}
