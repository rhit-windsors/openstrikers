+// SetMatrix() stores into TLTextInstance::m_DrawInfo.pMatrix, which is an
+// nlGCPtr32 -- four bytes, because StringDrawInfo is embedded in a serialized
+// .fen image and cannot change size. On hardware the stack was in MEM1, so the
+// address of a local fit; here it is a host stack address whose top bits are
+// dropped on the way in, and nlTextBox::DrawString then dereferences whatever
+// the low half happens to name. Whether that faults depends on where ASLR put
+// the stack, which is why it looked like an intermittent crash minutes into a
+// run. Keep the scratch matrix in MEM1 so the pointer survives the round trip.
+//
+// One instance is enough: SetMatrix() is only ever read back by the Render()
+// call immediately below it, which does not re-enter this function.
+static nlMatrix4* GetTextMatrixScratch()
+{
+    static nlMatrix4* pScratch = nullptr;
+    if (pScratch == nullptr)
+    {
+        pScratch = new (nlMalloc(sizeof(nlMatrix4), 32, false)) nlMatrix4;
+    }
+    return pScratch;
+}
