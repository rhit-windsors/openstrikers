 #include "NL/nlDLRing.h"
 #include "NL/MemAlloc.h"
 
+#include <pthread.h>
+
+// The GameCube was single-threaded, but this port installs the game's allocator
+// as the *global* operator new (see nlMemory.cpp), so Dawn's worker threads now
+// allocate through it concurrently with the main thread. Nothing here is
+// reentrant -- a free-list walk racing an insert corrupts the ring -- so
+// serialise every entry point. Statically initialised so it is usable from the
+// static constructors that allocate before main().
+static pthread_mutex_t s_nlAllocLock = PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP;
+
+namespace
+{
+struct nlAllocLock
+{
+    nlAllocLock() { pthread_mutex_lock(&s_nlAllocLock); }
+    ~nlAllocLock() { pthread_mutex_unlock(&s_nlAllocLock); }
+};
+} // namespace
+
 // Built with `-inline deferred`: MWCC emits .text in REVERSE source order, so the
