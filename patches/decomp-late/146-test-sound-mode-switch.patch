# OPENSTRIKERS_TEST_SOUND_MODE=DOLBY|STEREO|MONO: start in that sound mode.
#
# Dolby Pro Logic II is otherwise only reachable through the options menu,
# and switching to it restarts the whole sound system. With this set, the
# front end applies the mode when it applies the saved options (exercising
# that restart), and a run that skips the front end starts the sound system
# in Pro Logic II directly. Inert unless the variable is set.
--- a/src/Game/Audio/AudioLoader.cpp
+++ b/src/Game/Audio/AudioLoader.cpp
@@ -12,6 +12,11 @@
 #include "NL/nlFileGC.h"
 #include "dolphin/arq.h"
 
+#ifdef TARGET_PC
+#include <cstdlib>
+#include <cstring>
+#endif
+
 int nlSNPrintf(char*, unsigned long, const char*, ...);
 
 bool AudioLoader::gbStream = true;
@@ -569,6 +574,22 @@
     return dpl2Result;
 }
 
+#ifdef TARGET_PC
+// OPENSTRIKERS_TEST_SOUND_MODE=DOLBY (see UserOptions.cpp) also starts the
+// sound system in Pro Logic II here, for runs that skip the front end and so
+// never apply the options.
+static bool StartInTestSoundMode()
+{
+    const char* testMode = std::getenv("OPENSTRIKERS_TEST_SOUND_MODE");
+    if (testMode == NULL || std::strcmp(testMode, "DOLBY") != 0)
+        return false;
+    PlatAudio::ActivateDPL2();
+    Audio::Initialize(true);
+    PlatAudio::SetOutputMode(MusyXOutputType_SURROUND);
+    return true;
+}
+#endif
+
 /**
  * Offset/Address/Size: 0x356C | 0x80147338 | size: 0x80
  */
@@ -601,6 +622,10 @@
 
     FEAudio::BuildAnimAudioEventLookup();
     g_FEStreamConfig.LoadFromFile("audio/data/streams/FEStreams.txt");
+#ifdef TARGET_PC
+    if (StartInTestSoundMode())
+        return true;
+#endif
     Audio::Initialize(false);
     return true;
 }
@@ -632,6 +657,10 @@
 
