+    // OPENSTRIKERS_MATCH_SECONDS=<n> shortens (or lengthens) every match, so an
+    // unattended run reaches the final whistle and the end-of-game recaps in
+    // minutes instead of a full 300-second game. Inert unless set.
+    if (const char* v = getenv("OPENSTRIKERS_MATCH_SECONDS"))
+    {
+        const float seconds = (float)atof(v);
+        if (seconds > 0.0f)
+        {
+            fGameDuration = seconds;
+            fprintf(stderr, "openstrikers: OPENSTRIKERS_MATCH_SECONDS: game duration %.0f\n", seconds);
+        }
+    }
