+static bool glx_TraceLighting()
+{
+    static const bool enabled = [] {
+        const char* value = getenv("OPENSTRIKERS_TRACE_LIGHTING");
+        return value != NULL && value[0] != '\0' && value[0] != '0';
+    }();
+    return enabled;
+}
+
+static void glx_TraceColour(const char* kind, const nlFloatColour& source, const nlColour& packed)
+{
+    if (!glx_TraceLighting())
+    {
+        return;
+    }
+
+    // These values repeat for hundreds of packets. Keep one line per distinct
+    // kind/value pair so the trace describes the scene's lighting palette.
+    static u32 seen[3][128];
+    static u32 seenCount[3];
+    const u32 kindIndex = kind[0] == 'w' ? 0 : kind[0] == 'a' ? 1 : 2;
+    const u32 value = (u32)packed.c[0] << 24 | (u32)packed.c[1] << 16 | (u32)packed.c[2] << 8 | packed.c[3];
+    for (u32 i = 0; i < seenCount[kindIndex]; ++i)
+    {
+        if (seen[kindIndex][i] == value)
+        {
+            return;
+        }
+    }
+    if (seenCount[kindIndex] < 128)
+    {
+        seen[kindIndex][seenCount[kindIndex]++] = value;
+    }
+    fprintf(stderr,
+        "LIGHTDBG frame=%u view=%d program=%08X %s float=(%.4f,%.4f,%.4f,%.4f) byte=(%u,%u,%u,%u)\n",
+        glx_DebugFrame, (int)prev_view, glx_program, kind,
+        source.c[0], source.c[1], source.c[2], source.c[3],
+        packed.c[0], packed.c[1], packed.c[2], packed.c[3]);
+}
 
