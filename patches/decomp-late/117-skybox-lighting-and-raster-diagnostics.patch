+// Sum a texture's pixel bytes, so a texture whose memory is being overwritten
+// after upload shows up as a checksum that changes from frame to frame.
+static unsigned skydbg_checksum(const void* p, unsigned n)
+{
+    if (p == NULL) return 0u;
+    const unsigned char* b = (const unsigned char*)p;
+    unsigned h = 2166136261u;
+    for (unsigned i = 0; i < n; i++) { h = (h ^ b[i]) * 16777619u; }
+    return h;
+}
