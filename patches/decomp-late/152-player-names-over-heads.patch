+// Network play names the human behind each controller slot (osHostPadName),
+// and the name replaces the controller number: the HUD's heading font, in the
+// number's colour with the same dark outline. Slots 4-7 take the colours of
+// 0-3, as they take the number art. Returns false to fall back to the number.
+static const unsigned char s_aIndicatorColour[4][3] = {
+    { 244, 228, 52 }, // 1 yellow
+    { 60, 196, 228 }, // 2 blue
+    { 4, 212, 52 },   // 3 green
+    { 180, 68, 68 },  // 4 red
+};
+
+static bool DrawPlayerName(float fX, float fY, cPlayer* pCharacter, float fScale, float fOpacity, float fHighlight, bool bKeepOnScreen)
+{
+    enum { kMaxNameChars = 12 };
+    const int slot = pCharacter->GetGlobalPad()->m_padIndex;
+    const char* name = osHostPadName(slot);
+    if (name == NULL)
+    {
+        return false;
+    }
+    nlFont* pFont = FontManager::Instance()->GetFontByHashID(nlStringLowerHash("cepoitalic24"));
+    if (pFont == NULL)
+    {
+        return false;
+    }
+
+    // Capitals, like the HUD's team names, and only characters the font has:
+    // nlFont::DrawString never finishes a string holding one it lacks.
+    unsigned short text[kMaxNameChars + 1];
+    int length = 0;
+    float width = 0.0f;
+    for (const char* p = name; *p != 0 && length < kMaxNameChars; p++)
+    {
+        unsigned short c = (unsigned char)*p;
+        if (c >= 'a' && c <= 'z')
+        {
+            c -= 'a' - 'A';
+        }
+        if (c < 0x20 || c > 0x7E || pFont->m_GlyphLookup[c - 0x20].UnicodeChar == 0xFFFF)
+        {
+            continue;
+        }
+        width += (float)pFont->GetCharWidth(c, length > 0 ? text[length - 1] : 0) * pFont->m_Metrics.Spacing;
+        text[length++] = c;
+    }
+    text[length] = 0;
+    if (length == 0)
+    {
+        return false;
+    }
+
+    // Highlighted (just switched to, or on the ball) washes toward white, as
+    // the number's additive glow does.
+    const unsigned char* rgb = s_aIndicatorColour[slot & 3];
+    const float white = 0.6f * fHighlight;
+    const unsigned char alpha = (unsigned char)(255.0f * fOpacity);
+    nlColour colour;
+    nlColour outline;
+    nlColourSet(colour, (unsigned char)(rgb[0] + (255 - rgb[0]) * white), (unsigned char)(rgb[1] + (255 - rgb[1]) * white),
+        (unsigned char)(rgb[2] + (255 - rgb[2]) * white), alpha);
+    nlColourSet(outline, 40, 42, 45, alpha);
+
+    // At the screen edge, keep the whole name on screen (640 wide, 16 margin).
+    if (bKeepOnScreen)
+    {
+        const float half = 0.5f * width * fScale + 16.0f;
+        if (fX < half)
+        {
+            fX = half;
+        }
+        else if (fX > 640.0f - half)
+        {
+            fX = 640.0f - half;
+        }
+    }
+
+    // The glyphs are laid out at the font's size around (fX, fY) and scaled
+    // about that point by the poly matrix.
+    unsigned long hMatrix = glAllocMatrix();
+    unsigned long* pMatrix = NULL;
+    if (hMatrix + 0x10000 != 0xFFFF)
+    {
+        nlMatrix4 m;
+        m.SetIdentity();
+        m.m11 = fScale;
+        m.m22 = fScale;
+        m.m41 = fX * (1.0f - fScale);
+        m.m42 = fY * (1.0f - fScale);
+        glSetMatrix(hMatrix, m);
+        pMatrix = &hMatrix;
+    }
+
+    FontCharString string;
+    string.m_pString = text;
+    string.m_InternalBuffer = 0;
+    nlVector2 position;
+    position.x = fX - 0.5f * width;
+    position.y = fY + 0.5f * (float)pFont->m_Metrics.RenderAscent;
+    // The outline pass by hand: PASS_TextAndEffect draws its effect half
+    // flipped in any view but 0, and this 2D view runs top-down.
+    if (pFont->m_TextureType == SplitFX)
+    {
+        pFont->DrawString((eGLView)27, string, position, outline, outline, length, nlFont::PASS_Effect, false, pMatrix, NULL);
+    }
+    pFont->DrawString((eGLView)27, string, position, colour, colour, length, nlFont::PASS_Text, false, pMatrix, NULL);
+    return true;
+}
