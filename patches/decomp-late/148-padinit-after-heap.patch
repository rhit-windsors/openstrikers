# Call PADInit after the game heap exists.
#
# The decomp's operator new is the game allocator, and the first host
# allocation runs nlInitMemory. That marks memory initialised before building
# StandardAllocator, so anything nlInitMemory calls must not allocate until
# the heap is up. Since Aurora's input rewrite (aurora 40cf48f), PADInit
# registers an input layer, which allocates, and it crashed reading an empty
# free list on the very first frame.
--- a/src/NL/nlMemory.cpp
+++ b/src/NL/nlMemory.cpp
@@ -125,7 +125,6 @@
         VMAlloc(0x7E000000, 0x900000);
         DVDInit();
         VIInit();
-        PADInit();
 
         void* arenaLo = OSGetArenaLo();
         void* arenaHi = OSGetArenaHi();
@@ -149,6 +148,11 @@
 
         StandardAllocator.Initialize(ptr, heapSize - 0x40000);
         VirtualAllocator.Initialize((void*)0x7E000000, 0x900000);
+        // On hardware PADInit came first, but here operator new is the game's
+        // allocator, and Aurora's PADInit allocates: it registers an input
+        // layer. Called before StandardAllocator exists, that allocation finds
+        // s_MemoryInitialized already set and walks an empty free list.
+        PADInit();
         OSReport("After nlInitMemory\n");
         OSReport("Free Memory: %u\n", StandardAllocator.TotalFreeMemory());
         OSReport("Largest Free Block: %u\n", StandardAllocator.LargestFreeBlock());
