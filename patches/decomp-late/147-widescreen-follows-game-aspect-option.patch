+// The EFB size the game configured at startup. Aurora maps GX viewports,
+// scissors and copy rects from this logical size onto its render target, which
+// can change size or aspect afterwards.
+void glplatGetEFBSize(u32* width, u32* height);
 void glx_Fog(bool enable);
 bool glx_GetFog();
 bool glplatPostStartup();
