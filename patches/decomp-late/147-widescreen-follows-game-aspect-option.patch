+    // the widescreen camera data and the movie choice all agree with it.
+    bool& bWidescreen = GameInfoManager::Instance()->mUserInfo.mVisualOptions.mIsWidescreen;
+    bWidescreen = osHostSyncWidescreen(bWidescreen);
