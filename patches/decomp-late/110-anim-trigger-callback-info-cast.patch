# Animation trigger callbacks matched against the wrong field, so none matched.
#
# CharacterTriggers read cb->m_nParam1 as a cSAnim* and compared
# pTriggerAnim->GetHashID() against the trigger id. m_nParam1 is actually the
# AnimTagCBInfo that SetupAnimationTriggers hung off the callback. Reading it
# as a cSAnim worked on the GameCube purely by coincidence of layout:
# cSAnim::m_uHashID and AnimTagCBInfo::ScriptInfo.Trigger both sit at offset
# 0x4 there. Here AnimTagCBInfo leads with an AnimTagScriptInterpreter*, which
# is eight bytes, so ScriptInfo moves to 0x8 and the old cast read the top half
# of that pointer instead of a trigger id.
#
# Nothing crashed -- no trigger ever matched, so every consumer of animation
# milestones silently got zeroes. The goalie save table is the visible one:
# its milestone percentages were all zero, so keepers never timed a save.
--- a/src/Game/CharacterTriggers.cpp
+++ b/src/Game/CharacterTriggers.cpp
@@ -17,6 +17,9 @@
 #include "Game/SAnim.h"
 #include "Game/SAnim/pnSAnimController.h"
 #include "Game/Sys/debug.h"
