+// JUMBODBG: trace the in-stadium screens. The jumbotron pre-creates 16 texture
+// objects over a fixed buffer at Initialize() time, then refills that buffer by
+// DMA for each animation bundle without ever re-creating the objects -- so it
+// is the textbook case for a host renderer that caches uploads by object
+// identity. Set OPENSTRIKERS_JUMBO_DEBUG=1 to see the state machine, the frame
+// the game selected, and the first bytes actually sitting in that buffer.
+static bool JumboDbg()
+{
+    static const bool on = getenv("OPENSTRIKERS_JUMBO_DEBUG") != NULL;
+    return on;
+}
+
+static void JumboDbgFrame(const char* what, const char* name, unsigned long handle)
+{
+    if (!JumboDbg())
+        return;
+    PlatTexture* pTex = glx_GetTex(handle, false, false);
+    const unsigned char* p = pTex ? (const unsigned char*)pTex->m_SwizzledData : NULL;
+    fprintf(stderr, "JUMBODBG %s name=%s handle=%08lx pTex=%p data=%p bytes=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+            what, name, handle, (void*)pTex, (void*)p,
+            p ? p[0] : 0, p ? p[1] : 0, p ? p[2] : 0, p ? p[3] : 0,
+            p ? p[4] : 0, p ? p[5] : 0, p ? p[6] : 0, p ? p[7] : 0);
+    fflush(stderr);
+}
 
