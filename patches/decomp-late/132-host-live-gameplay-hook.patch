+// For the host autoplay driver (OPENSTRIKERS_AUTOPLAY): true only while the
+// ball is live -- not during the intro, kickoff, goal celebration, replay,
+// or anything after the final whistle. Autoplay plays at random only then;
+// everywhere else random input wanders off through the menus.
+extern "C" int osHostLiveGameplay()
+{
+    return g_pGame != NULL && g_pGame->IsGameplayOrOvertime() && !FrontEnd::m_bGameOver;
+}
