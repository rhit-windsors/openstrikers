@@ -1,4 +1,5 @@
 #include "Game/Game.h"
+#include "Game/FE/feManager.h"
 #include "Game/Sys/clock.h"
 #include "Game/Sys/eventman.h"
 #include "Game/Team.h"
@@ -34,6 +35,15 @@
 
