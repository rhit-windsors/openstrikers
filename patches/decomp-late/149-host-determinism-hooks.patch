# Host hooks that make the game deterministic under input replay and netplay.
#
# Lockstep netplay sends only controller input, so every machine must turn the
# same input into the same game. These are the points where the game took
# something from the outside world; each now asks the host (src/net/session.cpp),
# which answers as before when no session is active:
#
#   main.cpp       the random seed (was OSGetTick)
#   nlTask.cpp     the per-frame delta: a fixed 1/60 s under a session, else the
#                  existing OPENSTRIKERS_FIXED_STEP switch
#   nlFileGC.cpp   disc reads complete in AsyncManager::Service (aurora's
#                  deferred DVD mode) instead of on the DVD thread
#   platpad.cpp    every port's PADStatus for the frame comes from the host --
#                  a recording now, the agreed input of all players later
--- a/src/Game/main.cpp
+++ b/src/Game/main.cpp
@@ -173,7 +173,9 @@
     {
         nlBreak();
     }
-    nlSetRandomSeed(OSGetTick(), &nlDefaultSeed);
+    // The host supplies the seed when every machine (or a replay) has to draw
+    // the same numbers; otherwise it hands the tick straight back.
+    nlSetRandomSeed(osHostRandomSeed(OSGetTick()), &nlDefaultSeed);
     bool globalTexturesLoaded = glLoadTextureBundle("global.glt");
