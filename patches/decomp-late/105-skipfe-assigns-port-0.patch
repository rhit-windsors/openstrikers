--- a/src/Game/GameInfo.cpp
+++ b/src/Game/GameInfo.cpp
@@ -174,6 +174,22 @@
                 skipFEInfo = mGameInfo[mCurrentMode];
                 skipFEInfo->mPadSides[3] = 1;
             }
+
+            // GameInfoManager is constructed long before the first pad sample,
+            // and aurora reports a port as connected only once it has been
+            // read, so on the host every IsConnected above answers false and
+            // the match starts with all ten players on AI. That is not what
+            // skipping the front end is for -- it stands in for a user who
+            // set a match up by hand -- and it hides every bug that needs a
+            // controlled player, the overhead indicator among them. Port 0
+            // always exists here (keyboard, plus any gamepad), so give it
+            // side 0 when the host switch is what asked for the skip. The
+            // game's own `skipfe` config keeps the original behaviour.
+            if (osHostSkipFrontEnd() && !g_pFEInput->IsConnected((eFEINPUT_PAD)0))
+            {
+                skipFEInfo = mGameInfo[mCurrentMode];
+                skipFEInfo->mPadSides[0] = 0;
+            }
         }
     }
 
