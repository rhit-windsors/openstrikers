+ */
+void cCharacter::PostPhysicsUpdate()
+{
+    m_v3PrevPosition = m_v3Position;
+    m_pPhysicsCharacter->GetCharacterPositionXY(&m_v3Position);
+    m_pPhysicsCharacter->GetCharacterVelocityXY(&m_v3Velocity);
+
+    // PHYSDBG: ODE is handing back NaN x/y for some characters, which is what
+    // ends up as a NaN world matrix in the skinner. Report the transition, not
+    // the steady state, so the first bad step is visible.
+    {
+        static const bool sPhysDebug = getenv("OPENSTRIKERS_PHYS_DEBUG") != NULL;
+        if (sPhysDebug)
+        {
+            const bool nowNaN = (m_v3Position.x != m_v3Position.x) || (m_v3Position.y != m_v3Position.y);
+            const bool wasNaN = (m_v3PrevPosition.x != m_v3PrevPosition.x) || (m_v3PrevPosition.y != m_v3PrevPosition.y);
+            // The pitch is tens of units across, so anything past this is
+            // already diverging. Trace the run-up rather than only the NaN.
+            if (!nowNaN && (nlAbs(m_v3Position.x) > 60.0f || nlAbs(m_v3Position.y) > 60.0f))
+            {
+                fprintf(stderr, "PHYSDBG char=%u class=%d diverging pos=(%g,%g) prev=(%g,%g) vel=(%g,%g)\n",
+                        GetCharacterIndex(this), (int)m_eClassType,
+                        m_v3Position.x, m_v3Position.y,
+                        m_v3PrevPosition.x, m_v3PrevPosition.y,
+                        m_v3Velocity.x, m_v3Velocity.y);
+                fflush(stderr);
+            }
+            if (nowNaN && !wasNaN)
+            {
+                fprintf(stderr,
+                        "PHYSDBG char=%u class=%d went NaN: prev=(%g,%g,%g) now=(%g,%g,%g) vel=(%g,%g,%g)\n",
+                        GetCharacterIndex(this), (int)m_eClassType,
+                        m_v3PrevPosition.x, m_v3PrevPosition.y, m_v3PrevPosition.z,
+                        m_v3Position.x, m_v3Position.y, m_v3Position.z,
+                        m_v3Velocity.x, m_v3Velocity.y, m_v3Velocity.z);
+                fflush(stderr);
+            }
+        }
+    }
+
+    m_fActualSpeed = nlGetLength2D(m_v3Velocity.x, m_v3Velocity.y);
+
+    float angleRad = 0.0000958738f * (float)m_aActualFacingDirection;
+    nlMakeRotationMatrixZ(m_m4WorldMatrix, angleRad);
+
+    m_m4WorldMatrix.e2[3][0] = m_v3Position.x;
+    m_m4WorldMatrix.e2[3][1] = m_v3Position.y;
+    m_m4WorldMatrix.e2[3][2] = m_v3Position.z;
+
+    if (m_eClassType != GOALIE || ((m_v3Position.x * g_pBall->m_v3Position.x) > 0.0f))
+    {
+        m_pPoseAccumulator->MultNodeMatrices(&m_m4WorldMatrix);
+    }
+}
