+            mInsideByPass = false;
+            mByPassing = false;
+            mInterruptWipe = 0;
+            mUseInterruptWipe = 0;
+            mTimeInFunction = 0.0f;
+
+            NisPlayer::Instance()->SetExtraNameFilter("");
+            CallFunction(nlStringHash(functionName));
+        }
+    }
+
+    if (strcmp(mCurrentFunction, idleFun) == 0)
+    {
+        ReplayChoreo::Instance().Reset();
+    }
+}
