+    if (nlTaskManager::m_pInstance->m_CurrState != 0x10 && !IsDuringGamePauseState())
+    {
+        nlTaskManager::SetNextState(0x10);
+    }
+    ReplayChoreo::Instance().StartAutoReplay(type);
+    if (type == REPLAY_TYPE_HIGHLIGHT)
