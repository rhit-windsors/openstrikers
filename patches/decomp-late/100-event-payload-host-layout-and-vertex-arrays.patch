+static u32 glxStreamElementSize(u8 id, u8 stride)
+{
+    switch (id)
+    {
+    case 0:  return (stride == 12) ? 4u : 2u; // position: F32 or S16
+    case 1:  return (stride == 12) ? 4u : 1u; // normal: F32 or S8
+    case 2:  return 1u;                       // colour: RGBA8
+    case 12: return 1u;                       // matrix indices: direct, no array
