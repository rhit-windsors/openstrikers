+// Every .cam chunk holds 32-bit data: a key count, or arrays of float,
+// nlVector3 and nlQuaternion. It is read where it lands, and when ownsKeyData
+// is false the arrays below alias this buffer directly instead of being copied
+// out of it, so the swap has to happen here in either case. Each chunk range is
+// walked exactly once -- the by-filename overload frees its buffer immediately
+// afterwards, and the NIS overload hands each camera its own range -- so an
+// in-place swap cannot be applied twice.
+static void AnimCamSwapChunk(nlChunk* chunk)
+{
+    u32* p = (u32*)nlGetChunkData(chunk);
+    u32 bytes = (u32)((u8*)nlGetNextChunk(chunk) - (u8*)p);
+    for (u32 i = 0; i < bytes / 4; i++)
+    {
+        p[i] = nlByteSwap(p[i]);
+    }
+}
