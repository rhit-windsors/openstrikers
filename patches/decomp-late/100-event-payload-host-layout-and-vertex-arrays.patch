+
+// The vertex arrays live in one blob and several packets share them, so this
+// cannot swap per stream -- it would swap a shared array twice and leave it
+// exactly as it started. Collect the distinct start offsets instead, sort them,
+// and treat each array as running to the next one.
+static void glxSwapVertexArrays(u8* blob, u32 blobSize, const u8* streamTable, int numStreams)
+{
+    if (blob == NULL || blobSize == 0 || numStreams <= 0)
+    {
+        return;
+    }
+
+    u32* offsets = (u32*)nlMalloc(numStreams * sizeof(u32), 8, false);
+    u32* widths = (u32*)nlMalloc(numStreams * sizeof(u32), 8, false);
+    int n = 0;
+
+    for (int i = 0; i < numStreams; i++)
+    {
+        const glModelStream* stream = (const glModelStream*)(streamTable + i * sizeof(glModelStream));
+        const u32 offset = stream->address;
+        const u32 width = glxStreamElementSize(stream->id, stream->stride);
+
+        if (offset >= blobSize)
+        {
+            continue;
+        }
+
+        int at = 0;
+        bool dup = false;
+        for (; at < n; at++)
+        {
+            if (offsets[at] == offset)
+            {
+                dup = true;
+                break;
+            }
+            if (offsets[at] > offset)
+            {
+                break;
+            }
+        }
+        if (dup)
+        {
+            if (width > widths[at])
+            {
+                widths[at] = width;
+            }
+            continue;
+        }
+        for (int j = n; j > at; j--)
+        {
+            offsets[j] = offsets[j - 1];
+            widths[j] = widths[j - 1];
+        }
+        offsets[at] = offset;
+        widths[at] = width;
+        n++;
+    }
+
+    for (int i = 0; i < n; i++)
+    {
+        const u32 start = offsets[i];
+        const u32 end = (i + 1 < n) ? offsets[i + 1] : blobSize;
+        if (widths[i] == 4)
+        {
+            u32* p = (u32*)(blob + start);
+            u32* pEnd = (u32*)(blob + (end - ((end - start) & 3)));
+            for (; p < pEnd; p++)
+            {
+                *p = nlByteSwap(*p);
+            }
+        }
+        else if (widths[i] == 2)
+        {
+            u16* p = (u16*)(blob + start);
+            u16* pEnd = (u16*)(blob + (end - ((end - start) & 1)));
+            for (; p < pEnd; p++)
+            {
+                *p = nlByteSwap(*p);
+            }
+        }
+    }
+
+    nlFree(widths);
+    nlFree(offsets);
+}
