+void ShaderSkinMesh::Pose(cPoseAccumulator* pPoseAccumulator)
+{
+    SkinMatrix* foundMatrix;
+    unsigned long nodeID;
+    SkinMatrix result;
+    SkinMatrix skinMat;
+
+    for (int i = 0; i < pPoseAccumulator->GetNumNodes(); i++)
+    {
+        cSHierarchy* hierarchy = GetPoseHierarchy(pPoseAccumulator);
+        nlMatrix4* nodeMatrix = GetPoseNodeMatrixPtr(pPoseAccumulator, i);
+        nodeID = hierarchy->GetNodeID(i);
+
+        u8 found = boneMatrices.FindGet(nodeID, &foundMatrix);
+        if (found)
+        {
+            // POSEDBG: half the skinned draws hand GX NaN bone matrices. The
+            // product here has exactly two inputs, so report which one arrived
+            // bad rather than guessing at the animation system.
+            {
+                static bool sPoseDebug = getenv("OPENSTRIKERS_POSE_DEBUG") != NULL;
+                if (sPoseDebug)
+                {
+                    bool nodeNaN = false;
+                    bool boneNaN = false;
+                    const float* pn = (const float*)nodeMatrix;
+                    for (int k = 0; k < 16; k++)
+                    {
+                        if (pn[k] != pn[k]) { nodeNaN = true; }
+                    }
+                    for (int k = 0; k < 12; k++)
+                    {
+                        if (foundMatrix->m[k / 4][k % 4] != foundMatrix->m[k / 4][k % 4]) { boneNaN = true; }
+                    }
+                    if (nodeNaN || boneNaN)
+                    {
+                        static u32 sHits = 0;
+                        if ((sHits++ % 200) == 0)
+                        {
+                            fprintf(stderr,
+                                    "POSEDBG node=%d id=%lu nodeNaN=%d boneNaN=%d numNodes=%d node=[%g %g %g %g | %g %g %g %g | %g %g %g %g | %g %g %g %g]\n",
+                                    i, (unsigned long)nodeID, (int)nodeNaN, (int)boneNaN,
+                                    pPoseAccumulator->GetNumNodes(),
+                                    pn[0], pn[1], pn[2], pn[3], pn[4], pn[5], pn[6], pn[7],
+                                    pn[8], pn[9], pn[10], pn[11], pn[12], pn[13], pn[14], pn[15]);
+                            fflush(stderr);
+                        }
+                    }
+                }
+            }
+            skinMat.Set(*nodeMatrix);
+
+            nlMultMatrices(result, *foundMatrix, skinMat);
+
+            foundMatrix = poseMatrices.Add(nodeID, result);
+            if (foundMatrix != nullptr)
+            {
+                *foundMatrix = result;
+            }
+        }
+    }
+
+    for (int j = 0; j < numMorphs; j++)
+    {
+        morphWeights[j] = pPoseAccumulator->m_MorphWeights.mData[j];
+    }
+}
