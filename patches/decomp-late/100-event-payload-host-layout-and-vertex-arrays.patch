+    mInsideByPass = false;
+    mByPassing = false;
+    mInterruptWipe = 0;
+    mUseInterruptWipe = 0;
+    mTimeInFunction = 0.0f;
+    NisPlayer::Instance()->SetExtraNameFilter("");
+    CallFunction(nlStringHash("PlayHighlight"));
+}
