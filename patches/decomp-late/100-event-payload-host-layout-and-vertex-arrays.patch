+void* ShaderSkinMesh::MakeUserData(nlAVLTree<unsigned long, unsigned long, DefaultKeyCompare<unsigned long> >* boneMap)
+{
+    unsigned int count = boneMap->m_NumElements;
+    unsigned long size = count * 0x34 + 4;
