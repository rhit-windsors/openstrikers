@@ -263,7 +263,7 @@
         {
             u8 index;
             saved_ip = m_IP;
-            *m_SP = (u32)m_IP;
+            *m_SP = reinterpret_cast<std::uintptr_t>(m_IP);
             m_SP++;
             index = (u8)(op_low & 0xFF);
             m_IP = (u16*)((u8*)m_Header->m_CodeSegment + (m_Header->m_FunctionTable[index].offset & ~1));
