 namespace GCAudioStreaming
 {
+#ifdef __x86_64__
+static AudioStreamBuffer* sHostStreamUsers[64];
+
+unsigned long HostStreamUserRegister(AudioStreamBuffer* pBuffer)
+{
+    for (int i = 0; i < 64; i++)
+    {
+        if (sHostStreamUsers[i] == pBuffer || sHostStreamUsers[i] == NULL)
+        {
+            sHostStreamUsers[i] = pBuffer;
+            return (unsigned long)(i + 1);
+        }
+    }
+    return 0;
+}
+
+AudioStreamBuffer* HostStreamUserLookup(unsigned long handle)
+{
+    return (handle >= 1 && handle <= 64) ? sHostStreamUsers[handle - 1] : NULL;
+}
+#endif
 
