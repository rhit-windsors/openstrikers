+// THP files are big-endian: the header and info blocks are swapped once when
+// read, and the per-frame size words are read through this.
+static inline u32 THPFileWord(const void* p)
+{
+    return *(const nlBE<u32>*)p;
+}
+
+#if !NL_HOST_BIG_ENDIAN
+static void THPSwapWords(void* p, int count)
+{
+    u32* w = (u32*)p;
+    for (int i = 0; i < count; i++)
+    {
+        w[i] = nlByteSwap(w[i]);
+    }
+}
+#else
+static inline void THPSwapWords(void*, int) { }
+#endif
+
+#ifndef GOLDEN_DISABLE_AUDIO
+// musyx_host.c: there is no audio interface DMA to chain onto; the host mixer
+// hands each finished 5 ms frame to this hook instead (see THPHostMix).
+extern "C" void musyxHostSetPostMix(void (*fn)(s16* frame, u32 samples));
+static void THPHostMix(s16* frame, u32 samples);
+#endif
+
+// With no audio to pace decoding (AudioSystem 1, or a movie without sound),
+// THPSimpleDecode is called once per game frame; on the host that would play
+// a 29.97 fps movie at the game's frame rate. Decode only when the movie's
+// clock has reached the next frame.
+static OSTime PacingStart;
+static s32 PacingFrames;
