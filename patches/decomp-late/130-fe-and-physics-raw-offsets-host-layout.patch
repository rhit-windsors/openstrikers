# Three more fields reached through raw GameCube offsets, found by sweeping for
# the pattern after the soak's post-match soft-lock. (1)
# PausePostGameScene::Update, on B, re-pushes the summary and set its button
# state through offset 0xC3C; on the host SummaryOverlay::mButtonState is at
# 0xC54 and 0xC3C is the upper half of mSlideMenu. The summary was left with no
# A button -- the only way on from it, so a soft-lock -- and a wild slide-menu
# pointer. (2) Starting a cup set CupHubScene::mDoAutoSave through 0x226, which
# on the host is inside mAllTeamStats. (3) PhysicsBanana::SetContactInfo read
# PhysicsNPC::mpAINPC through 0x30 (it is at 0x48) and called vtable slot 0x0C
# on it, which on the NPC is GetSkinAnimatedNPC_Type: retail asks whether the
# NPC is Bowser. Use the named fields.
--- a/src/Game/SH/SHPausePostGame.cpp
+++ b/src/Game/SH/SHPausePostGame.cpp
@@ -10,6 +10,7 @@
 #include "Game/Game.h"
 #include "Game/GameInfo.h"
 #include "Game/OverlayManager.h"
+#include "Game/FE/Overlay/OverlayHandlerSummary.h"
 #include "NL/nlLocalization.h"
 #include "NL/nlString.h"
 
@@ -327,7 +328,12 @@
     if (g_pFEInput->JustPressed(FE_ALL_PADS, 0x200, false, NULL))
     {
         BaseSceneHandler* summary = nlSingleton<OverlayManager>::Instance()->Push(OVERLAY_SUMMARY, SCREEN_NOTHING, true);
-        *(ButtonComponent::ButtonState*)((u8*)summary + 0xC3C) = (ButtonComponent::ButtonState)1;
+        // Retail wrote BS_A_ONLY through raw offset 0xC3C, which is
+        // SummaryOverlay::mButtonState in the GameCube layout. On the host that
+        // offset is the upper half of mSlideMenu, so backing out of this menu
+        // left the summary with no A button -- a soft-lock, since A is the only
+        // way on from it -- and turned mSlideMenu into a wild pointer.
+        ((SummaryOverlay*)summary)->mButtonState = ButtonComponent::BS_A_ONLY;
         FEAudio::PlayAnimAudioEvent("sfx_back", false);
         return;
     }
