# The allocator validator's op log is a short ring, but the block that damages
# a free-ring node was usually allocated minutes earlier. Keep a separate map
# of every live allocation's extents and dump the allocations either side of a
# damaged node. Validator builds only (OPENSTRIKERS_MEMALLOC_VALIDATE). Written
# during the 2026-09-09 free-ring investigation and recovered unsaved from the
# working tree on 2026-10-08.
--- a/src/NL/MemAlloc.cpp
+++ b/src/NL/MemAlloc.cpp
@@ -113,6 +113,102 @@
 nlOpLogEntry s_nlOpLog[8192];
 unsigned s_nlOpLogNext = 0;
 
+// Keep the current allocation extents separately from the short circular
+// operation history. A free-ring node is usually damaged by the live block
+// immediately before it, which may have been allocated minutes earlier.
+struct nlActiveAllocation
+{
+    u32 user;
+    u32 userSize;
+    u32 blockLo;
+    u32 blockHi;
+};
+static const unsigned NL_ACTIVE_ALLOC_COUNT = 1 << 18;
+nlActiveAllocation s_nlActiveAllocations[NL_ACTIVE_ALLOC_COUNT];
+
+unsigned nlActiveHash(u32 user)
+{
+    return ((user >> 4) * 2654435761U) & (NL_ACTIVE_ALLOC_COUNT - 1);
+}
+
+void nlActiveAdd(void* userPtr, u32 userSize, void* blockLo, void* blockHi)
+{
+    const u32 user = (u32)(uintptr_t)userPtr;
+    unsigned firstTombstone = NL_ACTIVE_ALLOC_COUNT;
+    unsigned slot = nlActiveHash(user);
+    for (unsigned probes = 0; probes < NL_ACTIVE_ALLOC_COUNT; probes++)
+    {
+        nlActiveAllocation& entry = s_nlActiveAllocations[slot];
+        if (entry.user == user)
+        {
+            entry.userSize = userSize;
+            entry.blockLo = (u32)(uintptr_t)blockLo;
+            entry.blockHi = (u32)(uintptr_t)blockHi;
+            return;
+        }
+        if (entry.user == 1 && firstTombstone == NL_ACTIVE_ALLOC_COUNT)
+            firstTombstone = slot;
+        if (entry.user == 0)
+        {
+            if (firstTombstone != NL_ACTIVE_ALLOC_COUNT)
+                slot = firstTombstone;
+            s_nlActiveAllocations[slot].user = user;
+            s_nlActiveAllocations[slot].userSize = userSize;
+            s_nlActiveAllocations[slot].blockLo = (u32)(uintptr_t)blockLo;
+            s_nlActiveAllocations[slot].blockHi = (u32)(uintptr_t)blockHi;
+            return;
+        }
+        slot = (slot + 1) & (NL_ACTIVE_ALLOC_COUNT - 1);
+    }
+}
+
+void nlActiveRemove(void* userPtr)
+{
+    const u32 user = (u32)(uintptr_t)userPtr;
+    unsigned slot = nlActiveHash(user);
+    for (unsigned probes = 0; probes < NL_ACTIVE_ALLOC_COUNT; probes++)
+    {
+        nlActiveAllocation& entry = s_nlActiveAllocations[slot];
+        if (entry.user == user)
+        {
+            entry.user = 1;
+            return;
+        }
+        if (entry.user == 0)
+            return;
+        slot = (slot + 1) & (NL_ACTIVE_ALLOC_COUNT - 1);
+    }
+}
+
+void nlActiveDumpAround(u32 address)
+{
+    const nlActiveAllocation* before = NULL;
+    const nlActiveAllocation* after = NULL;
+    const nlActiveAllocation* containing = NULL;
+    for (unsigned i = 0; i < NL_ACTIVE_ALLOC_COUNT; i++)
+    {
+        const nlActiveAllocation& entry = s_nlActiveAllocations[i];
+        if (entry.user <= 1)
+            continue;
+        if (entry.blockLo <= address && address < entry.blockHi)
+            containing = &entry;
+        if (entry.blockHi <= address && (before == NULL || entry.blockHi > before->blockHi))
+            before = &entry;
+        if (entry.blockLo >= address && (after == NULL || entry.blockLo < after->blockLo))
+            after = &entry;
+    }
+    fprintf(stderr, "  active allocations around %08x:\n", address);
+    if (containing != NULL)
+        fprintf(stderr, "    CONTAINS block=%08x-%08x user=%08x size=%u\n", containing->blockLo,
+                containing->blockHi, containing->user, containing->userSize);
+    if (before != NULL)
+        fprintf(stderr, "    before   block=%08x-%08x user=%08x size=%u gap=%u\n", before->blockLo,
+                before->blockHi, before->user, before->userSize, address - before->blockHi);
+    if (after != NULL)
+        fprintf(stderr, "    after    block=%08x-%08x user=%08x size=%u gap=%u\n", after->blockLo,
+                after->blockHi, after->user, after->userSize, after->blockLo - address);
+}
+
 // Set NL_TRACE_ALLOC_SIZE (decimal or 0x-prefixed) to have every allocation of
