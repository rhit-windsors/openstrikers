-    mpSaveTable = (SaveData*)__construct_new_array(nlMalloc(sizeof(SaveData) * 0x45, 8, false), NULL, NULL,
+    // ClearData frees mpSaveTable - 0x10, so the array has to start 0x10 past
+    // the allocation. MWCC gets there through __construct_new_array, which
+    // writes its own array header into that space and returns the pointer past
+    // it; the shim this port builds against returns the block unchanged, so the
+    // offset has to be applied by hand -- and the allocation has to make room
+    // for it, which it did not. Without both, ClearData hands nlFree a pointer
+    // 0x10 bytes before the block, and the free-ring links land in the middle
+    // of the preceding allocation. Same bug, and same fix, as Config::Config.
+    u8* pSaveTableMem = (u8*)nlMalloc(sizeof(SaveData) * 0x45 + 0x10, 8, false);
+#ifndef __MWERKS__
+    pSaveTableMem += 0x10;
+#endif
+    mpSaveTable = (SaveData*)__construct_new_array(pSaveTableMem, NULL, NULL,
         sizeof(SaveData), 0x45);
 
