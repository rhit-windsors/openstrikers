--- a/src/Game/Effects/EffectsGroup.cpp
+++ b/src/Game/Effects/EffectsGroup.cpp
@@ -613,7 +613,21 @@
     }
     else
     {
-        pSpecs = new (nlMalloc(specCount * sizeof(EffectsSpec) + 0x10, 8, false)) EffectsSpec[specCount];
+        // ~EffectsGroup frees m_specs - 0x10, so the array has to start
+        // 0x10 past the allocation. MWCC writes its own array cookie into that
+        // space; the Itanium ABI emits no cookie at all for an element type
+        // with a trivial destructor, so under GCC the offset has to be applied
+        // by hand or the destructor hands nlFree a pointer that was never
+        // allocated. Same fix as Config::Config.
+#ifdef __MWERKS__
+        void* pSpecsMem = nlMalloc(specCount * sizeof(EffectsSpec) + 0x10, 8, false);
+#else
+        static_assert(__is_trivially_destructible(EffectsSpec),
+            "EffectsSpec gained a destructor: GCC now emits an array cookie and the "
+            "manual 0x10 offset below would double-count it");
+        void* pSpecsMem = (char*)nlMalloc(specCount * sizeof(EffectsSpec) + 0x10, 8, false) + 0x10;
+#endif
+        pSpecs = new (pSpecsMem) EffectsSpec[specCount];
         memcpy(pSpecs, specs, specCount * sizeof(EffectsSpec));
     }
 
