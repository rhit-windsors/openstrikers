# Deferred DVD completion, for input replay and lockstep netplay.
#
# The DVD worker thread completes a read whenever the disc access happens to
# finish, so a load lands on a different frame from run to run -- and in a game
# that polls for loads once a frame, that changes everything after it. Two
# machines that must compute the same game from the same input cannot have
# that. aurora_dvd_set_deferred(true) stops the worker taking commands; queued
# commands then run in submission order, with their callbacks, when the host
# calls aurora_dvd_service_deferred() -- the game does so from its file-system
# service, which every wait for a read already spins on.
#
# Blocking reads run the queue up to themselves, and a completion callback that
# closes or cancels its own file is recognised as running on the processing
# thread, so neither deadlocks.
--- a/include/aurora/dvd.h
+++ b/include/aurora/dvd.h
@@ -21,6 +21,24 @@
 void aurora_dvd_close(void);
 
 /**
+ * \brief Make asynchronous DVD commands complete at a point the host chooses.
+ *
+ * While deferred, queued commands are not run on the DVD worker thread. They
+ * run, in submission order, when aurora_dvd_service_deferred() is called, on
+ * the calling thread, and so do their completion callbacks. A host that
+ * services once per frame sees each read complete at the same frame on every
+ * run regardless of disc speed, which input replay and lockstep netplay need.
+ * Blocking reads still work: they run the queue up to themselves.
+ */
+void aurora_dvd_set_deferred(bool deferred);
+
+/**
+ * \brief Run every queued DVD command, including any that completion callbacks
+ * queue while this runs. Does nothing unless deferred mode is on.
+ */
+void aurora_dvd_service_deferred(void);
+
+/**
