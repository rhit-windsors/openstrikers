+  // Deferred mode: the worker thread stops taking commands, and queued
+  // commands run only when service_deferred() is called, in submission order,
+  // on the calling thread. A host that calls it once per frame gets every read
+  // completing at the same frame on every run, however long the disc access
+  // really took -- which lockstep netplay and input replay depend on.
+  void set_deferred(bool deferred) {
+    std::unique_lock lk{m_mutex};
+    m_deferred = deferred;
+    // Let a command the worker already took finish before the caller can
+    // start servicing on its own thread.
+    m_doneCv.wait(lk, [&] { return !m_running || m_activeBlock == nullptr; });
+    if (!deferred) {
+      lk.unlock();
+      m_cv.notify_one();
+    }
+  }
+
+  bool is_deferred() {
+    std::lock_guard lk{m_mutex};
+    return m_deferred;
+  }
+
+  // Runs queued commands until the queue is empty, including any that the
+  // completion callbacks submit, or until `until` has completed.
+  void service_deferred(const DVDCommandBlock* until = nullptr) {
+    // A blocking read inside a completion callback services recursively.
+    const std::thread::id outer = m_serviceThread;
+    m_serviceThread = std::this_thread::get_id();
+    while (true) {
+      DVDCommandBlock* block;
+      {
+        std::lock_guard lk{m_mutex};
+        if (!m_deferred || m_queue.empty()) {
+          break;
+        }
+        block = m_queue.front();
+        m_queue.pop_front();
+        m_activeBlock = block;
+        atomic_store_release(block->state, DVD_STATE_BUSY);
+      }
+      process_command(block);
+      {
+        std::lock_guard lk{m_mutex};
+        m_activeBlock = nullptr;
+        if (m_cancelActiveBlock == block) {
+          m_cancelActiveBlock = nullptr;
+        }
+      }
+      m_doneCv.notify_all();
+      if (block == until) {
+        break;
+      }
+    }
+    m_serviceThread = outer;
+  }
