 // these two funcs are out of scope for aurora::card. stubbed for now
+void CARDServicePendingCallbacks(void) {
+  // Swap the queue out before running anything: a callback is free to start
+  // another card operation, and that one belongs to the next frame, not this
+  // loop. Run them outside the lock for the same reason.
+  std::vector<PendingCallback> due;
+  {
+    std::lock_guard lock(s_pendingLock);
+    due.swap(s_pending);
+  }
+  for (const auto& entry : due) {
+    entry.callback(entry.chan, entry.result);
+  }
+}
