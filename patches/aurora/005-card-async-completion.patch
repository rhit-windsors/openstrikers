+// Every CARD*Async entry point completes off the EXI interrupt on hardware,
+// i.e. strictly after the Async call has returned. Callers are written for
+// that: the memory-card state machine kicks off an operation and only then
+// records the pointers its completion handler will read, so a callback invoked
+// inline runs against half-built state (and, in the save path, against
+// uninitialised member pointers). Nothing here actually blocks, so queue the
+// completion and let CARDServicePendingCallbacks run it at the top of the next
+// host frame.
+struct PendingCallback {
+  CARDCallback callback;
+  s32 chan;
+  s32 result;
+};
+std::mutex s_pendingLock;
+std::vector<PendingCallback> s_pending;
+
+s32 QueueCardCallback(const CARDCallback callback, const s32 chan, const s32 result) {
+  if (callback != nullptr) {
+    std::lock_guard lock(s_pendingLock);
+    s_pending.push_back({callback, chan, result});
+  }
+  return result;
+}
