+void GXInitFogAdjTable(GXFogAdjTable* table, u16 width, const f32 projmtx[4][4]) {
+  CHECK(table != nullptr, "null fog adjustment table");
+  CHECK(width != 0 && width <= 640, "invalid fog adjustment width {}", width);
+
+  f32 nearZ;
+  f32 sideX;
+  if (projmtx[3][3] == 0.0f) {
+    nearZ = projmtx[2][3] / (projmtx[2][2] - 1.0f);
+    sideX = nearZ / projmtx[0][0];
+  } else {
+    sideX = 1.0f / projmtx[0][0];
+    nearZ = 1.73205f * sideX;
+  }
+
+  const f32 inverseWidth = 2.0f / static_cast<f32>(width);
+  for (u32 i = 0; i < 10; ++i) {
+    f32 x = static_cast<f32>((i + 1) << 5) * inverseWidth * sideX;
+    const f32 range = std::sqrt(1.0f + (x * x) / (nearZ * nearZ));
+    table->r[i] = static_cast<u16>(static_cast<u32>(256.0f * range) & 0xFFF);
+  }
+}
