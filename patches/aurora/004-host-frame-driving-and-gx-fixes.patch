+// --- frame dump --------------------------------------------------------------
+// There is no reliable way to screenshot this window from outside the process:
+// the swapchain is a DXGI flip-model surface, so GDI's CopyFromScreen captures
+// whatever the compositor has at those desktop coordinates and PrintWindow hands
+// back a stale DWM bitmap. Reading the present source straight off the GPU is
+// the only capture that is actually of this frame. Set AURORA_DUMP_FRAME=<n> to
+// write frame n as a binary PPM in the working directory, or "every:<n>" for one
+// every n frames.
+struct FrameDumpConfig {
+  bool enabled = false;
+  bool periodic = false;
+  uint64_t target = 0;
+};
+
+FrameDumpConfig parse_frame_dump_config() {
+  FrameDumpConfig config;
+  const char* spec = std::getenv("AURORA_DUMP_FRAME");
+  if (spec == nullptr || *spec == '\0') {
+    return config;
+  }
+  std::string_view view{spec};
+  if (view.starts_with("every:")) {
+    config.periodic = true;
+    view.remove_prefix(6);
+  }
+  uint64_t value = 0;
+  const auto result = std::from_chars(view.data(), view.data() + view.size(), value);
+  if (result.ec != std::errc{} || value == 0) {
+    return config;
+  }
+  config.enabled = true;
+  config.target = value;
+  return config;
+}
+
+bool should_dump_frame(uint64_t frameNo) {
+  static const FrameDumpConfig config = parse_frame_dump_config();
+  if (!config.enabled) {
+    return false;
+  }
+  return config.periodic ? (frameNo % config.target) == 0 : frameNo == config.target;
+}
+
+void write_frame_ppm(uint64_t frameNo, const uint8_t* pixels, uint32_t width, uint32_t height, uint32_t bytesPerRow,
+                     bool bgra) {
+  char path[64];
+  std::snprintf(path, sizeof(path), "frame_%llu.ppm", static_cast<unsigned long long>(frameNo));
+  FILE* out = std::fopen(path, "wb");
+  if (out == nullptr) {
+    Log.warn("Frame dump: cannot open {}", path);
+    return;
+  }
+  std::fprintf(out, "P6\n%u %u\n255\n", width, height);
+  std::vector<uint8_t> row(static_cast<size_t>(width) * 3);
+  for (uint32_t y = 0; y < height; ++y) {
+    const uint8_t* src = pixels + static_cast<size_t>(y) * bytesPerRow;
+    for (uint32_t x = 0; x < width; ++x) {
+      row[x * 3 + 0] = src[x * 4 + (bgra ? 2 : 0)];
+      row[x * 3 + 1] = src[x * 4 + 1];
+      row[x * 3 + 2] = src[x * 4 + (bgra ? 0 : 2)];
+    }
+    std::fwrite(row.data(), 1, row.size(), out);
+  }
+  std::fclose(out);
+  Log.info("Frame dump: wrote {} ({}x{})", path, width, height);
+}
+
+struct PendingFrameDump {
+  wgpu::Buffer buffer;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t bytesPerRow = 0;
+  bool bgra = true;
+};
+
+// Records the copy on this frame's encoder. The readback itself has to wait for
+// the submit that carries it, so the caller resolves this after Submit.
+PendingFrameDump record_frame_dump(const wgpu::CommandEncoder& encoder) {
+  PendingFrameDump pending;
+  const auto& source = webgpu::present_source();
+  if (!source.texture) {
+    return pending;
+  }
+  pending.width = source.size.width;
+  pending.height = source.size.height;
+  pending.bgra = source.format == wgpu::TextureFormat::BGRA8Unorm ||
+                 source.format == wgpu::TextureFormat::BGRA8UnormSrgb;
+  // CopyTextureToBuffer requires a 256-byte-aligned row stride.
+  pending.bytesPerRow = (pending.width * 4 + 255) & ~255u;
+  const wgpu::BufferDescriptor descriptor{
+      .label = "Frame dump staging buffer",
+      .usage = wgpu::BufferUsage::CopyDst | wgpu::BufferUsage::MapRead,
+      .size = static_cast<uint64_t>(pending.bytesPerRow) * pending.height,
+  };
+  pending.buffer = g_device.CreateBuffer(&descriptor);
+  const wgpu::TexelCopyTextureInfo src{.texture = source.texture};
+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = {.bytesPerRow = pending.bytesPerRow, .rowsPerImage = pending.height},
+      .buffer = pending.buffer,
+  };
+  const wgpu::Extent3D extent{.width = pending.width, .height = pending.height, .depthOrArrayLayers = 1};
+  encoder.CopyTextureToBuffer(&src, &dst, &extent);
+  return pending;
+}
+
+void resolve_frame_dump(PendingFrameDump& pending, uint64_t frameNo) {
+  if (!pending.buffer) {
+    return;
+  }
+  bool done = false;
+  bool ok = false;
+  pending.buffer.MapAsync(wgpu::MapMode::Read, 0, wgpu::kWholeMapSize, wgpu::CallbackMode::AllowProcessEvents,
+                          [&done, &ok](wgpu::MapAsyncStatus status, wgpu::StringView message) {
+                            ok = status == wgpu::MapAsyncStatus::Success;
+                            if (!ok) {
+                              Log.warn("Frame dump: map failed: {}", std::string_view{message});
+                            }
+                            done = true;
+                          });
+  while (!done) {
+    webgpu::g_instance.ProcessEvents();
+  }
+  if (ok) {
+    const auto* data = static_cast<const uint8_t*>(pending.buffer.GetConstMappedRange());
+    if (data != nullptr) {
+      write_frame_ppm(frameNo, data, pending.width, pending.height, pending.bytesPerRow, pending.bgra);
+    }
+    pending.buffer.Unmap();
+  }
+  pending.buffer = {};
+}
